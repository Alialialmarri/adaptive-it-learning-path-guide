# Copy this file to backend/.env and fill in the values. backend/.env is ignored by Git.
# Google AI Studio key, used only by the backend (never put it in the frontend).
GOOGLE_API_KEY=
# Required: random value of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Optional: answer model of the AI tutor
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# Optional: minimum relevance (0-1) for a question to count as in the current module
RAG_RELEVANCE_THRESHOLD=0.45
